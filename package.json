{
  "name": "nest-boilerplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tscx -rc",
    "dev": "tscx -rcw -e dist/main.js",
    "postinstall": "fenge install",
    "style": "fenge",
    "style:update": "fenge -u"
  },
  "dependencies": {
    "@nestjs/common": "10.4.12",
    "@nestjs/core": "10.4.12",
    "@nestjs/platform-express": "10.4.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@rnm/tscx": "0.1.4",
    "@types/node": "22.10.1",
    "fenge": "0.1.8",
    "typescript": "5.7.2"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=18"
  }
}
