{
  "name": "nest-boilerplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tscx -rc",
    "dev": "tscx -rcw -e dist/main.js",
    "postinstall": "fenge install",
    "style": "fenge",
    "style:update": "fenge -u"
  },
  "dependencies": {
    "@nestjs/common": "10.4.12",
    "@nestjs/core": "10.4.12",
    "@nestjs/platform-express": "10.4.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@rnm/tscx": "0.3.7",
    "@types/node": "20.19.9",
    "fenge": "0.9.7",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.12.4"
    }
  }
}
